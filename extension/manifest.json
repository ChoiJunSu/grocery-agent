{
  "manifest_version": 3,
  "name": "스마트 장보기 에이전트",
  "description": "로그인된 마트 세션에서 가격/쿠폰을 수집하고, 최적화된 장바구니를 자동으로 담습니다. 비밀번호는 절대 수집하지 않습니다.",
  "version": "0.2.0",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "http://localhost:3001/*",
    "https://emart.ssg.com/*",
    "https://pay.ssg.com/*",
    "https://front.homeplus.co.kr/*",
    "https://mfront.homeplus.co.kr/*",
    "https://www.coupang.com/*",
    "https://cart.coupang.com/*",
    "https://www.kurly.com/*",
    "https://m.kurly.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://emart.ssg.com/*", "https://pay.ssg.com/*"],
      "js": ["content/common.js", "content/emart.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://front.homeplus.co.kr/*", "https://mfront.homeplus.co.kr/*"],
      "js": ["content/common.js", "content/homeplus.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.coupang.com/*", "https://cart.coupang.com/*"],
      "js": ["content/common.js", "content/coupang.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.kurly.com/*", "https://m.kurly.com/*"],
      "js": ["content/common.js", "content/kurly.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "스마트 장보기 에이전트"
  }
}
