# 서울 열린데이터광장 인증키 (무료)
# 발급: https://data.seoul.go.kr/together/mypage/actKeyMain.do
# 이 키가 있어야 코트 목록/접수상태를 가져온다. 없으면 collect가 즉시 중단된다.
SEOUL_API_KEY=

# 슬롯 그리드를 몇 일치 볼지 (기본 30)
TENNIS_DAYS=30

# 브라우저 동시 실행 수. 공공 사이트라 과하게 올리지 말 것 (기본 3)
TENNIS_CONCURRENCY=3

# 로컬 서버 포트 (기본 3100)
TENNIS_PORT=3100

# playwright가 받은 chromium 대신 이미 설치된 크롬을 쓰고 싶을 때만 지정
# 예: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
TENNIS_CHROME_PATH=
